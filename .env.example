# 複製此檔為 .env 並填入實際值
# cp .env.example .env

# ── Database ────────────────────────────────────────────────────
# 地端開發：使用本機 Homebrew postgresql（多專案共用同一實例，各自獨立 DB + user）
#   DB_HOST=localhost
# Cloud Run：連 Cloud SQL 時 DB_HOST 設為 unix socket，例如
#   DB_HOST=/cloudsql/<INSTANCE_CONNECTION_NAME>
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sensei_crawler
DB_USER=sensei_user
DB_PASSWORD=
DB_MAX_CONN=5

# ── Gemini AI ───────────────────────────────────────────────────
# 從 Google AI Studio 取得：https://aistudio.google.com/apikey
AI_PROVIDER=gemini
GEMINI_API_KEY=
