# 複製此檔為 .env 並填入實際值
# cp .env.example .env

# ── Database ────────────────────────────────────────────────────
# 本機 Homebrew postgresql（多專案共用同一實例，各自獨立 DB + user）
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sensei_crawler
DB_USER=sensei_user
DB_PASSWORD=
DB_MAX_CONN=5

# ── App 管理面板 ────────────────────────────────────────────────
# 設定後，UI 的「資料管理工具」需輸入此密碼才能使用。
# App 綁 0.0.0.0 開放區網時請務必設定。
ADMIN_PASSWORD=

# ── Gemini AI ───────────────────────────────────────────────────
# 從 Google AI Studio 取得：https://aistudio.google.com/apikey
AI_PROVIDER=gemini
GEMINI_API_KEY=
